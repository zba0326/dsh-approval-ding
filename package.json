{
  "name": "dsh-approval-ding",
  "version": "1.0.0",
  "description": "Play one short chime when DSH waits for a human decision: a tool approval or a question with choices.",
  "type": "module",
  "license": "MIT",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "approval",
    "notification",
    "sound",
    "macos"
  ],
  "homepage": "https://github.com/zba0326/dsh-approval-ding#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zba0326/dsh-approval-ding.git"
  },
  "bugs": {
    "url": "https://github.com/zba0326/dsh-approval-ding/issues"
  },
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
